{
  "name": "learnhub",
  "version": "2.1.0",
  "private": true,
  "description": "课程学习与 AI 出题平台 · 一套代码同时支持 Cloudflare Workers(D1) 与国内云(MySQL)",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "node server.js",
    "dev:file": "node server.js --file",
    "dev:mysql": "node server.js --mysql",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/api.test.js",
    "sql:mysql": "node scripts/make-mysql-sql.js",
    "seed:sql": "node scripts/make-seed-sql.js",
    "hash": "node scripts/hash-password.js",
    "db:local": "wrangler d1 execute learnhub --local --file=./migrations/0001_schema.sql",
    "db:seed:local": "node scripts/make-seed-sql.js && wrangler d1 execute learnhub --local --file=./migrations/0002_seed.sql",
    "db:remote": "wrangler d1 execute learnhub --remote --file=./migrations/0001_schema.sql",
    "db:seed:remote": "node scripts/make-seed-sql.js && wrangler d1 execute learnhub --remote --file=./migrations/0002_seed.sql",
    "db:migrate": "node scripts/migrate-mysql.js"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=20"
  }
}
