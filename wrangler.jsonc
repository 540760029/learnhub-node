{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnhub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],

  // 前端静态资源：public/ 目录不打包进 Worker，由 Cloudflare 全球边缘直接分发。
  // run_worker_first=true 让请求先过 Worker，这样 /api/* 才会命中后端路由，
  // 其余路径再由 Worker 转给 ASSETS 绑定。
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // D1 数据库绑定（已在 Cloudflare 上创建）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learnhub",
      "database_id": "ab1d2e84-1b97-4e68-8181-78d703e15f75"
    }
  ],

  // 非敏感配置放这里；密钥用 `npx wrangler secret put LEARNHUB_SECRET`
  "vars": {
    "LEARNHUB_DEFAULT_PROVIDER": "deepseek",
    "LEARNHUB_DAILY_AI_LIMIT": "3",
    "LEARNHUB_PLATFORM_API_KEY": ""
  },

  "observability": {
    "enabled": true
  },

  // 免费版够用；如需限流/更细日志可自行加
  "placement": { "mode": "smart" }
}
